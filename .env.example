# 前端环境变量配置（复制此文件为 .env.local 并填入真实值）

# Mapbox Access Token
# 获取地址: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# 管理员密码 (用于登录后台)
VITE_ADMIN_PASSWORD=your_admin_password_here

# API 服务器地址 (可选，默认 http://localhost:3001)
VITE_API_BASE_URL=http://localhost:3001

# Cesium Ion Access Token（三维沙盘用，可选；不填则使用免费数据源）
# 获取地址: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# Mapbox 自定义样式 URL（地图页底图样式）
VITE_MAPBOX_STYLE=your_mapbox_style_url_here
